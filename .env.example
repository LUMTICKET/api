# ---- Core ----
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=https://lumticket.com

# ---- Email (2FA codes, invitations) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@example.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=Lumticket <sender@example.com>

# ---- PayChangu: the only payment provider (TNM Mpamba, Airtel Money, bank cards) ----
# Dashboard -> Settings -> API & Webhooks. Use the TEST secret key (sec-test-...) while testing, the LIVE one in production.
PAYCHANGU_SECRET_KEY=
# Webhook URL to register in the dashboard: https://<your-api-host>/api/payments/paychangu/webhook
PAYCHANGU_WEBHOOK_SECRET=            # webhook signing secret from the dashboard (falls back to the secret key)

# Where payers return after PayChangu's secure payment page (card, or every method in hosted mode)
BUYER_SITE_URL=https://lumticket.com              # ticket buyers  -> <BUYER_SITE_URL><BUYER_RETURN_PATH>
BUYER_RETURN_PATH=/tickets                        # /tickets on lumticket.com; use /bookings if buyers use the app
BUSINESS_SITE_URL=https://business.lumticket.com  # business owners paying the publishing fee
BUSINESS_RETURN_PATH=                             # optional, e.g. /dashboard
# PAYCHANGU_CALLBACK_URL=                         # optional: override the callback (defaults to the return URL)
# PAYCHANGU_BASE_URL=https://api.paychangu.com    # optional

# Optional: pin the PayChangu mobile money operator ids (otherwise found by name via GET /mobile-money)
# PAYCHANGU_OPERATOR_TNM=
# PAYCHANGU_OPERATOR_AIRTEL=

# ---- Optional ----
PUBLIC_API_URL=https://api.lumticket.com   # shown as the webhook URL in the config check
PUBLISHING_FEE_MWK=10000

# Extra website origins allowed to call this API from a browser (comma separated)
ALLOWED_ORIGINS=
